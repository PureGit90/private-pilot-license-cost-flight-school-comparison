---
export interface Props { title: string; headers: string[]; rows: string[][]; note?: string; }
const { title, headers, rows, note } = Astro.props;
---
<div class="table-wrap">
  <table>
    <caption>{title}</caption>
    <thead><tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r[0]}</th>
          {r.slice(1).map((cell, i) => <td data-label={headers[i + 1]}>{cell}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
{note && <p class="small">{note}</p>}
